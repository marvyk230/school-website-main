DATABASE_URL="file:./dev.db"

JWT_ACCESS_TOKEN_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_TOKEN_SECRET="replace-with-a-different-random-secret-at-least-32-characters"

# For Vercel/Neon, configure these in the hosting dashboard instead of committing secrets.
# DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"
# Use the pooled URL for DATABASE_URL and the direct Neon URL for DIRECT_URL/migrations.

# Optional: set these before running `pnpm db:seed` to choose initial admin credentials.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-10-characters
# ADMIN_EMAIL=admin@example.com
