{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run school website (Nuxt)",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"dev"
			],
			"options": {
				"cwd": "${workspaceFolder}\\app",
				"env": {
					"NUXT_TELEMETRY_DISABLED": "1"
				}
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}